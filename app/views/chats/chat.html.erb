<div class="chat-page">

  <div class="chat-sidebar">
    <%= link_to dashboard_path do %>
      <%= image_tag "back-white", alt: "back-arrow", class: "icon-feature" %>
    <% end %>
  </div>

  <div class="chat-history text-center">
    <div class="history-header">
      <h4>History</h4>
    </div>
    <div class="history-list">
      <% @history.each do |r| %>
          <div class="card-history">
            <div class="text-neon"><%= r.date %></div>
            <small class="history-distance"><%= r.distance %> km</small>
          </div>
      <% end %>
    </div>
  </div>

  <div class="chat-window">
    <div class="chat-title text-center p-4">
      <h2>Chat about your run on <span class="text-neon"><%= @run.date %></span></h2>
      <p>Insights derived from your 5-run training history.</p>
    </div>

    <div class="messages-area flex-grow-1 overflow-auto p-4">
      <% @messages.each do |message| %>
        <div class="message-<%= message.role %>">
          <%= markdown(message.content) %>
        </div>
      <% end %>
    </div>

    <div class="chat-input">
      <%= form_with url: chat_run_path, method: :post, class: "mt-3" do |f| %>
        <div class="input-group">
          <%= f.text_field :message, class: "form-control", placeholder: "Escreve uma pergunta...", required: true %>
          <%= f.submit "Enviar", class: "btn btn-primary pb-3" %>
        </div>
      <% end %>
    </div>

  </div>
</div>

<script>

  function scrollToBottom() {
    const messagesArea = document.querySelector('.messages-area');
    if (messagesArea) {
      setTimeout(() => {
        messagesArea.scrollTo({
          top: messagesArea.scrollHeight,
          behavior: 'smooth'
        });
      }, 150);
    }
  }

  window.addEventListener('load', scrollToBottom);

  scrollToBottom();
</script>
