<div class="form-container">
  <%= simple_form_for @run do |f| %>
    <%= f.input :date, as: :date, html5: true, required: true %>
    <%= f.input :distance, label: "Distance (km)", required: true %>
    <div class="row">
      <div class="col-4">
        <%= f.input :hours, label: "Hours", required: true, input_html: { value: 0, min: 0, step: 1 } %>
      </div>
      <div class="col-4">
        <%= f.input :minutes, label: "Minutes", required: true, input_html: { value: 0, min: 0, max: 59, step: 1 } %>
      </div>
      <div class="col-4">
        <%= f.input :seconds, label: "Seconds", required: true, input_html: { value: 0, min: 0, max: 59, step: 1 } %>
      </div>
    </div>
    <%= f.input :heart_rate %>
    <%= f.input :cadence %>
    <%= f.input :elevation %>

    <div class="text-center mt-4">
      <%= f.button :submit, "Save Run", class: "btn-primary" %>
    </div>
  <% end %>
</div>
